        "message": "=<div style=\"font-family:sans-serif;max-width:560px;margin:0 auto;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden\"><div style=\"background:#0f766e;padding:24px;text-align:center\"><h1 style=\"color:#fff;margin:0;font-size:20px\">⚠️ Alerta de Vencimento de Certificado</h1></div><div style=\"padding:24px\"><p style=\"font-size:16px\">Olá, <strong>{{ $json.funcionario_nome }}</strong>!</p><p>O certificado abaixo está próximo do vencimento:</p><table style=\"width:100%;border-collapse:collapse;margin:16px 0\"><tr style=\"background:#f0fdf4\"><td style=\"padding:10px;border:1px solid #d1fae5;font-weight:bold\">Treinamento</td><td style=\"padding:10px;border:1px solid #d1fae5\">{{ $json.treinamento_nome }}</td></tr><tr><td style=\"padding:10px;border:1px solid #e5e7eb;font-weight:bold\">Vencimento</td><td style=\"padding:10px;border:1px solid #e5e7eb\">{{ $json.data_validade_fmt }}</td></tr><tr style=\"background:#f0fdf4\"><td style=\"padding:10px;border:1px solid #d1fae5;font-weight:bold\">Situação</td><td style=\"padding:10px;border:1px solid #d1fae5\"><strong>{{ $json.urgencia }}</strong></td></tr></table><p style=\"color:#6b7280;font-size:13px\">Por favor, providencie a renovação do certificado com antecedência.</p></div><div style=\"background:#f9fafb;padding:16px;text-align:center;font-size:12px;color:#9ca3af\">Portal SafeTrack HSE — Notificação automática</div></div>",
