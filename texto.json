        "jsCode": "const alertas = $input.first().json.alertas || [];\n\nreturn alertas.map(a => ({\n  json: {\n    ...a,\n    data_validade_fmt: new Date(a.data_validade).toLocaleDateString('pt-BR'),\n    urgencia:\n      a.dias_restantes === 0  ? '🚨 VENCEU HOJE' :\n      a.dias_restantes === 1  ? '🔴 VENCE AMANHÃ' :\n      a.dias_restantes <= 7   ? '🟠 URGENTE'      :\n      a.dias_restantes <= 15  ? '🟡 ATENÇÃO'      :\n                                '🔵 AVISO'\n  }\n}));"
      },
      "id": "77a3459c-03aa-46b9-8f70-c94ba8c1f116",
